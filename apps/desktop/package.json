{
  "name": "probelab-desktop",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite --host localhost --port 1420",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check:styles": "node scripts/check-style-legibility.mjs",
    "check:icons": "node scripts/check-icons-current.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "icons": "tauri icon src-tauri/app-icon.svg -o src-tauri/icons && node scripts/copy-favicon.mjs && node scripts/check-icons-current.mjs --write"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
